ENVIRONMENT=development
LOG_LEVEL=INFO

POSTGRES_DB=pokemon_daily
POSTGRES_USER=pokemon_daily
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql+asyncpg://pokemon_daily:change_me@db:5432/pokemon_daily

APP_TIMEZONE=Europe/Moscow
DAILY_DELIVERY_TIME=08:00
WORKER_POLL_SECONDS=60
DELIVERY_BATCH_SIZE=50
DELIVERY_RETRY_LIMIT=4
SENDING_STALE_MINUTES=15
COLLECTION_PAGE_SIZE=5

MAX_BOT_TOKEN=
MAX_WEBHOOK_SECRET=replace-with-5-to-256-safe-characters
MAX_API_BASE_URL=https://platform-api2.max.ru
MAX_CA_BUNDLE=/tmp/max-ca-bundle.pem
PUBLIC_BASE_URL=https://bot.example.com
WEBHOOK_PATH=/webhook/max
WEBHOOK_MAX_BODY_BYTES=262144

POKEAPI_BASE_URL=https://pokeapi.co/api/v2
POKEAPI_TIMEOUT_SECONDS=20
POKEAPI_REQUEST_DELAY_SECONDS=0.05
EDITORIAL_CONTENT_PATH=data/editorial